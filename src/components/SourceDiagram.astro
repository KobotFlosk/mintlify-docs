---
import { Code } from '@astrojs/starlight/components';
import { renderMermaidSVG } from 'beautiful-mermaid';

interface Props {
  file: string;
  index?: number;
  title: string;
  description: string;
}

const { file, index = 1, title, description } = Astro.props;
const sources = import.meta.glob<string>('../../docs/*.md', {
  query: '?raw', import: 'default', eager: true,
});
const source = sources[`../../docs/${file}`];
const block = source && [...source.matchAll(/^```([^\n]*)\n([\s\S]*?)^```/gm)][index - 1];
if (!block) throw new Error(`Missing source diagram ${file}:${index}`);
const language = block[1].trim();
const diagram = block[2].replace(/\n$/, '');
const id = `source-diagram-${file.replace(/\.md$/, '')}-${index}`;
let svg = '';
if (language === 'mermaid') {
  // Preserve source nodes, edges, and labels; wrap only their visual presentation.
  const wrapped = diagram.replace(/\["([^"\n]+)"\]/g, (_, label: string) => {
    const lines = label.split('\\n').flatMap((line) => {
      const wrappedLines = [''];
      for (const word of line.split(' ')) {
        const last = wrappedLines.length - 1;
        if (wrappedLines[last] && wrappedLines[last].length + word.length + 1 > 36) wrappedLines.push(word);
        else wrappedLines[last] += (wrappedLines[last] ? ' ' : '') + word;
      }
      return wrappedLines;
    });
    return `["${lines.join('\\n')}"]`;
  });
  svg = renderMermaidSVG(wrapped, {
    font: 'Arial', padding: 24, transparent: true,
    bg: 'var(--sl-color-bg-nav)', fg: 'var(--sl-color-text)',
  })
    .replace(/<style>[\s\S]*?<\/style>/g, '')
    .replace(/(?<=\s)id="([^"]+)"/g, `id="${id}-$1"`)
    .replace(/url\(#([^)]+)\)/g, `url(#${id}-$1)`);
}
---

<figure data-source-diagram={`${file}:${index}`}>
  <figcaption id={`${id}-caption`}>{title}</figcaption>
  {svg ? (
    <div class="chart-scroll" tabindex="0" role="region" aria-labelledby={`${id}-caption`}>
      <div role="img" aria-label={description} set:html={svg} />
    </div>
  ) : <Code code={diagram} lang="text" />}
</figure>

<style>
  figure { margin: 1.5rem 0; min-width: 0; }
  figcaption { margin-bottom: 0.5rem; color: var(--sl-color-white); font-weight: 600; }
  .chart-scroll { overflow-x: auto; border: 1px solid var(--sl-color-gray-5); border-radius: 0.4rem; background: var(--sl-color-bg-nav); }
  .chart-scroll:focus-visible { outline: 2px solid var(--sl-color-accent-high); outline-offset: 3px; }
  .chart-scroll > div { width: max-content; min-width: 100%; }
  figure :global(svg) {
    display: block; max-width: none; margin: 0 auto;
    --_text: var(--sl-color-text); --_text-sec: var(--sl-color-gray-2);
    --_text-muted: var(--sl-color-gray-2); --_line: var(--sl-color-gray-2);
    --_arrow: var(--sl-color-gray-2); --_node-fill: var(--sl-color-bg);
    --_node-stroke: var(--sl-color-gray-3); --_inner-stroke: var(--sl-color-gray-5);
  }
  figure :global(text) { font-family: Arial, system-ui, sans-serif; }
</style>
